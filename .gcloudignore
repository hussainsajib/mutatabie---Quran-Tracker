# Tells `gcloud builds submit` which files NOT to upload as the build source.
# Dockerfile, .dockerignore, and deploy/cloudbuild.yaml stay included (the build
# needs them); this only excludes secrets and local build artifacts.

# ── Node ─────────────────────────────────────────────────────────────
node_modules/
dist/
*.tsbuildinfo

# ── Python ───────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
*.db
*.sqlite3

# ── Env / secrets ────────────────────────────────────────────────────
.env
*.env.local

# ── Static assets served from GCS (not part of the app image) ───────
frontend/public/fonts/qpcv1/
frontend/public/fonts/qpcv2/
frontend/public/fonts/qpcv4/
frontend/public/fonts/surah-name-v4.woff2
frontend/public/fonts/QCF4_Hafs_01_W.woff2
frontend/public/mushaf/

# ── Logs & OS ────────────────────────────────────────────────────────
*.log
.DS_Store
Thumbs.db

# ── IDE ──────────────────────────────────────────────────────────────
.idea/
.vscode/

# ── Git ──────────────────────────────────────────────────────────────
.git
