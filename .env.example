# ── Core ─────────────────────────────────────────────────────────────
ENVIRONMENT=development
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=false

# ── Database (Neon connection string in production) ──────────────────
# Neon provides: postgresql://user:password@host/db?sslmode=require
# For SQLAlchemy async we use the asyncpg driver:
DATABASE_URL=postgresql+asyncpg://quran_tracker:CHANGE_ME@localhost:5432/quran_tracker

# ── Auth ─────────────────────────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=false

# ── Google OAuth (create credentials in Google Cloud Console) ────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5100/api/auth/google/callback

# ── Frontend / CORS ──────────────────────────────────────────────────
# In production set this to your Cloud Run HTTPS URL.
FRONTEND_ORIGIN=http://localhost:5173
