# ── Core ─────────────────────────────────────────────────────────────
ENVIRONMENT=development
# JWT signing secret, used by both docker-compose and backend dev. Generate:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=false

# ── Database ─────────────────────────────────────────────────────────
# Local Postgres password (raw). The docker-compose `db` service uses this.
POSTGRES_PASSWORD=CHANGE_ME

# Same password, URL-encoded for use inside DATABASE_URL strings. Keep this in
# sync with POSTGRES_PASSWORD above. Encode special characters:
#   @ → %40   # → %23   / → %2F   : → %3A   ? → %3F   % → %25
# Example: password "p@ssword" → encoded "p%40ssword".
POSTGRES_PASSWORD_ENCODED=CHANGE_ME

# DATABASE_URL for local dev (uvicorn/alembic) points at localhost and must use
# the URL-encoded password. In production use the Neon connection string.
# Neon provides: postgresql://user:password@host/db?sslmode=require — but the
# asyncpg driver needs ssl=require instead:
#   postgresql+asyncpg://user:password@host/db?ssl=require
DATABASE_URL=postgresql+asyncpg://quran_tracker:CHANGE_ME@localhost:5432/quran_tracker

# ── Auth ─────────────────────────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=false

# ── Google OAuth (create credentials in Google Cloud Console) ────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5100/api/auth/google/callback

# ── Frontend / CORS ──────────────────────────────────────────────────
# In production set this to your Cloud Run HTTPS URL.
FRONTEND_ORIGIN=http://localhost:5173
